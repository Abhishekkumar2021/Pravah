# syntax=docker/dockerfile:1

# ============================================================================
# Pravah Runner Dockerfile
# Standalone runner for customer infrastructure
# ============================================================================

FROM eclipse-temurin:25-jre-alpine AS runtime

# Install Docker CLI (for container job execution)
RUN apk add --no-cache docker-cli

# Security: Run as non-root user
RUN addgroup -g 1000 pravah && \
    adduser -u 1000 -G pravah -D pravah && \
    addgroup pravah docker || true

WORKDIR /app

# Copy the fat JAR
COPY runner/build/libs/*-all.jar pravah-runner.jar

# Create work directory
RUN mkdir -p /work && chown -R pravah:pravah /work /app

USER pravah

# JVM configuration
ENV JAVA_OPTS="-XX:+UseG1GC \
    -XX:MaxRAMPercentage=75.0 \
    -Djava.security.egd=file:/dev/./urandom"

ENV WORK_DIR=/work

VOLUME ["/work", "/var/run/docker.sock"]

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar pravah-runner.jar --work-dir=$WORK_DIR $@"]
