# .gitignore

# Build artifacts
target/
build/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war

# Gradle (local caches / IDE output — not the wrapper scripts)
**/.gradle/
**/bin/

# IDE
.idea/
*.iml
.vscode/
*.swp

# Node
node_modules/
.next/

# Env / secrets
.env
.env.*
*.env

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
