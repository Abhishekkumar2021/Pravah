# Copy to backend/.env (gitignored):  cp env.local.example .env
# Loaded automatically by: make local-up, make local-services, etc.

# --- Local sign-in (US-10.01; after make local-seed) ---
# Email: dev@localhost.pravah   Password: PravahDev1!

# --- Demo tenant defaults (registration + UI project scope hints) ---
PRAVAH_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
PRAVAH_DEV_USER_ID=22222222-2222-4222-8222-222222222222
PRAVAH_DEV_PROJECT_ID=33333333-3333-4333-8333-333333333333

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- Database (optional; omit to use application.yml defaults for local docker) ---
# DB_USERNAME=<same as POSTGRES_USER in docker-compose.yml>
# DB_PASSWORD=<same as POSTGRES_PASSWORD in docker-compose.yml>

# --- Kafka (docker-compose external listener) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- JWT verification (tenant-service JWKS on 8082) ---
PRAVAH_JWKS_URL=http://localhost:8082/.well-known/jwks.json
PRAVAH_JWT_ISSUER=pravah-dev

# --- Execution realtime (US-12.10) ---
PRAVAH_REALTIME_REDIS_ENABLED=true
PRAVAH_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Service URLs (execution → pipeline catalog) ---
PIPELINE_SERVICE_BASE_URL=http://localhost:8083

# --- Local process dirs (created by scripts/local/setup.sh) ---
PRAVAH_LOCAL_DIR=.local
PRAVAH_LOCAL_LOG_DIR=.local/logs
PRAVAH_LOCAL_PID_DIR=.local/pids
