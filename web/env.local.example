# Copy to web/.env.local (gitignored):  cp env.local.example .env.local
# Or run from repo root:  make -C backend local-setup

# Vite dev server proxies /api and /ws to the gateway (see vite.config.ts)
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Default project for GET /api/v1/pipelines?projectId=… (matches PRAVAH_DEV_PROJECT_ID in backend/.env)
VITE_PRAVAH_PROJECT_ID=33333333-3333-4333-8333-333333333333

# Optional: absolute API base when not using the Vite proxy (production / preview builds)
# VITE_PRAVAH_API_BASE=
