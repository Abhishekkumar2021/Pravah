# Optional: absolute gateway URL when not using Vite dev proxy
# VITE_PRAVAH_API_BASE=https://api.example.com

# Optional: default project UUID for pipeline list/dashboard (same as GET /api/v1/pipelines?projectId=)
# VITE_PRAVAH_PROJECT_ID=00000000-0000-4000-8000-000000000000

# Optional: gateway for Vite proxy (npm run dev)
# VITE_DEV_PROXY_TARGET=http://localhost:8080
